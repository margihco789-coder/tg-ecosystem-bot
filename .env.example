# Example .env file for TG Ecosystem Bot
# Copy to `.env` and fill the values before running the bot

# Telegram
BOT_TOKEN=your_bot_token_here

# Operation mode
DEBUG=true
LOG_LEVEL=INFO

# Webhook (optional)
# Set USE_WEBHOOK to true to run the bot in webhook mode and provide WEBHOOK_URL
USE_WEBHOOK=false
WEBHOOK_URL="https://example.com/webhook"  # full public URL (optional)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8443
WEBHOOK_PATH=/webhook

# Optional: secret for site webhook
SITE_WEBHOOK_SECRET=some_secret_if_needed

# Your external API (optional)
YOUR_API_BASE_URL=https://api.example.com
YOUR_API_KEY=your_api_key_here

# Redis
REDIS_URL=redis://localhost:6379/0
