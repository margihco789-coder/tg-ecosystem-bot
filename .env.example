# .env.example — Приклад змінних середовища для tg-ecosystem-bot
# НЕ зберігайте реальні секрети у репозиторії; цей файл показує структуру змінних.

# Токен Telegram бота (обов'язковий)
# Формат: 123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ
BOT_TOKEN="123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"

# Секрет для webhook з сайту (опційно)
SITE_WEBHOOK_SECRET="your_webhook_secret_here"

# Ваше API (опційно)
YOUR_API_BASE_URL="https://api.example.com"
YOUR_API_KEY="your_api_key_here"

# Redis (рекомендовано для production)
# Формат: redis://[:password@]host:port/db
REDIS_URL="redis://localhost:6379/0"

# Режим налагодження (True/False)
DEBUG="True"

# Рівень логування: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
